{
  "name": "app-live",
  "version": "0.1.0",
  "description": "Build an Expo app locally with EAS and install it onto a device — a physical device connected to your machine, or a BrowserStack App Live cloud device. Ships as both an MCP server and a CLI.",
  "keywords": [
    "expo",
    "eas",
    "browserstack",
    "app-live",
    "mcp",
    "react-native",
    "ios",
    "android"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "app-live": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start:mcp": "node dist/mcp.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
